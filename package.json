{
  "name": "sussplanner",
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "validate:setup": "node scripts/validate-project.mjs --mode=setup",
    "validate:dev": "node scripts/validate-project.mjs --mode=dev",
    "validate:build": "node scripts/validate-project.mjs --mode=build",
    "validate:start": "node scripts/validate-project.mjs --mode=start",
    "predev": "npm run validate:dev && npm run quotes:build",
    "dev": "next dev",
    "prebuild": "npm run validate:build && npm run quotes:build",
    "build": "next build",
    "prestart": "npm run validate:start",
    "start": "next start",
    "quotes:build": "tsx scripts/build-quotes.ts",
    "quotes:test": "tsx scripts/test-build-quotes.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "drizzle-orm": "^0.44.7",
    "html-to-image": "^1.11.11",
    "next": "^16.0.0",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.6.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.12",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.14",
    "drizzle-kit": "^0.31.4",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
